{
  "name": "marriott-hotels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://iamspring.github.io/MarriottHotels",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run build:server && concurrently \"node --watch dist/server.js\" \"npx prisma studio\"",
    "build": "tsc && vite build",
    "build:server": "tsup",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:react": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.react.ts",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cypress:run",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --testMatch '**/__tests__/**/*.integration.test.ts'",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --testMatch '**/__tests__/**/*.unit.test.ts'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "start:prod": "node dist/server.js",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:report": "playwright show-report",
    "test:playwright:install": "playwright install",
    "test:playwright:codegen": "playwright codegen",
    "test:playwright:show-trace": "playwright show-trace",
    "test:playwright:screenshot": "playwright test --project=chromium --grep='screenshot'",
    "test:playwright:visual": "playwright test --project=chromium --grep='visual'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@apollo/server": "^4.12.2",
    "@datadog/browser-logs": "^4.47.0",
    "@datadog/browser-rum": "^4.47.0",
    "@graphql-tools/mock": "^9.0.23",
    "@graphql-tools/schema": "^10.0.23",
    "@graphql-tools/utils": "^10.8.6",
    "@headlessui/react": "^1.7.18",
    "@langchain/core": "^0.3.61",
    "@pinecone-database/pinecone": "^6.1.1",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.45.1",
    "@trpc/react-query": "^10.45.0",
    "@trpc/server": "^10.45.1",
    "@types/formidable": "^3.4.5",
    "@types/html2canvas": "^1.0.0",
    "@types/next": "^9.0.0",
    "@types/next-auth": "^3.15.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/recharts": "^2.0.1",
    "@types/socket.io-client": "^3.0.0",
    "@types/winston": "^2.4.4",
    "apollo-server-express": "^3.13.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dd-trace": "^4.55.0",
    "express": "^4.18.3",
    "express-fileupload": "^1.5.1",
    "formidable": "^3.5.4",
    "graphql": "^16.11.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.29",
    "lucide-react": "^0.323.0",
    "mermaid": "^11.7.0",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "openai": "^5.7.0",
