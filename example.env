# Example environment variables for MarriottHotels
# Rename this file to .env for local development

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
VITE_AI_ASSISTANT_ID=your_assistant_id_here
VITE_AI_ADMIN_ID=your_admin_assistant_id_here
VITE_ENABLE_AI_CHAT=true

# Vite Configuration
VITE_API_URL=http://localhost:5173/api
VITE_AUTH_DOMAIN=localhost
VITE_PROJECT_ID=marriott-hotels

# Vite environment variables must start with VITE_
VITE_API_KEY=your-test-api-key
VITE_STORAGE_BUCKET=your-storage-bucket
VITE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_APP_ID=your-app-id
VITE_MEASUREMENT_ID=your-measurement-id

# Add more as needed for your local setup 