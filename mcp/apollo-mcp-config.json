{
  "rover": {
    "endpoint": "http://localhost:4000/graphql",
    "introspect": true,
    "schema": "./mcp/schema.graphql",
    "operations": {
      "directory": "./mcp/operations",
      "auto_discover": true,
      "hot_reload": true
    }
  },
  "server": {
    "port": 5000,
    "host": "localhost",
    "transport": "stdio"
  },
  "logging": {
    "level": "info",
    "file": "./mcp/logs/apollo-mcp.log"
  }
} 